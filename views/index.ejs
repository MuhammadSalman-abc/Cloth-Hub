<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VOGUE DENIM | <%= title %></title>
  <link rel="icon" type="image/svg+xml" href="/images/vogue-denim-favicon.svg?v=2">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/style.css?v=20261127">
  <style>#imagePreviewOverlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.9);z-index:10000;cursor:zoom-out;align-items:center;justify-content:center}.load-status{min-height:1.5rem}</style>
</head>
<body>
<%- include('partials/site-loader') %>
  <div class="page-scroll-progress" aria-hidden="true"><span id="scrollProgress"></span></div>
  <div id="imagePreviewOverlay" onclick="this.style.display='none'"><img id="fullImage" src="" alt="Product preview" style="max-width:90%;max-height:90%;border-radius:10px"></div>
  <nav class="navbar navbar-expand-lg navbar-dark store-navbar sticky-top mb-4">
    <div class="container">
      <a href="/" class="navbar-brand"><img class="store-logo" src="/images/vogue-denim-logo.svg?v=2" alt="Vogue Denim — Jeans and Shirts"></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#storeNavigation" aria-controls="storeNavigation" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
      <div class="collapse navbar-collapse" id="storeNavigation">
        <ul class="navbar-nav ms-lg-4 me-auto">
          <li class="nav-item"><a class="nav-link <%= !category ? 'active' : '' %>" href="/" <%= !category ? 'aria-current="page"' : '' %>>All</a></li>
          <li class="nav-item"><a class="nav-link <%= category === 'men' ? 'active' : '' %>" href="/men" <%= category === 'men' ? 'aria-current="page"' : '' %>>Men</a></li>
          <li class="nav-item"><a class="nav-link <%= category === 'women' ? 'active' : '' %>" href="/women" <%= category === 'women' ? 'aria-current="page"' : '' %>>Women</a></li>
          <li class="nav-item"><a class="nav-link <%= category === 'kids' ? 'active' : '' %>" href="/kids" <%= category === 'kids' ? 'aria-current="page"' : '' %>>Kids</a></li>
        </ul>
        <div class="store-account">
          <span class="store-greeting">Hi, <strong><%= user.name %></strong></span>
          <a href="/orders" class="btn btn-outline-light btn-sm">My orders</a>
          <a href="/cart" class="btn btn-warning btn-sm fw-semibold">Cart</a>
          <% if (isAdmin) { %><a href="/admin" class="btn btn-light btn-sm">Admin</a><% } %>
          <form action="/logout" method="post"><button class="btn btn-outline-danger btn-sm">Log out</button></form>
        </div>
      </div>
    </div>
  </nav>
  <main class="container">
    <% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-success auto-dismiss-notice" role="status"><%= notice %></div><% } %>
    <section class="store-hero mb-4">
      <div class="store-hero-copy"><p class="eyebrow">VOGUE DENIM · JEANS & SHIRTS</p><h1><%= category ? title : 'Wear the style.' %></h1><p>Everyday denim, thoughtfully selected for your own kind of confidence.</p><a class="btn btn-gold" href="#collection">Explore collection <span aria-hidden="true">↓</span></a></div>
      <div class="store-hero-stamp" aria-hidden="true">
        <svg class="store-hero-stamp-ring" viewBox="0 0 180 180" focusable="false">
          <defs>
            <pattern id="heroDenimWeave" width="10" height="10" patternUnits="userSpaceOnUse">
              <rect width="10" height="10" fill="#203e53"/>
              <path d="M0 2h10M0 7h10" stroke="#8da6b5" stroke-opacity=".34" stroke-width="1"/>
              <path d="M2 0v10M7 0v10" stroke="#071925" stroke-opacity=".72" stroke-width="1"/>
              <path d="M-2 8 8 -2M3 13 13 3" stroke="#52748b" stroke-opacity=".32" stroke-width="1.4"/>
            </pattern>
            <mask id="heroFabricRingMask">
              <rect width="180" height="180" fill="black"/>
              <circle cx="90" cy="90" r="83" fill="white"/>
              <circle cx="90" cy="90" r="59" fill="black"/>
            </mask>
            <linearGradient id="heroFabricSheen" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#fff" stop-opacity=".3"/>
              <stop offset=".52" stop-color="#fff" stop-opacity="0"/>
              <stop offset="1" stop-color="#071925" stop-opacity=".45"/>
            </linearGradient>
          </defs>
          <circle cx="90" cy="90" r="83" fill="url(#heroDenimWeave)" mask="url(#heroFabricRingMask)"/>
          <circle cx="90" cy="90" r="83" fill="url(#heroFabricSheen)" mask="url(#heroFabricRingMask)"/>
          <circle cx="90" cy="90" r="81" fill="none" stroke="#e7bd65" stroke-opacity=".8" stroke-width="1.2"/>
          <circle cx="90" cy="90" r="75" fill="none" stroke="#f2d48c" stroke-opacity=".9" stroke-width="1.3" stroke-dasharray="1.5 4.2"/>
          <circle cx="90" cy="90" r="65" fill="none" stroke="#e7bd65" stroke-opacity=".5" stroke-width="1"/>
          <g class="ring-clothing ring-jeans-top" transform="translate(90 15) scale(3.1) translate(-90 -15)" aria-hidden="true">
            <path d="M79 2h22l-2 13-3 10h-7l-1-8-1 8h-7l-3-10z" fill="#315e7b" stroke="#f1d18a" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M79 5h22m-11 0v9m-8-6-2 9m16-9 2 9" fill="none" stroke="#e7bd65" stroke-width="1.1"/>
          </g>
          <g class="ring-clothing ring-shirt-right" transform="translate(173 97) scale(3.1) translate(-173 -97)" aria-hidden="true">
            <path d="m161 77 10 6 10-6 11 7-5 11-6-3 3 25h-25l3-25-6 3-5-11z" fill="#e9e5dc" stroke="#f1d18a" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="m161 77 10 11 10-11m-10 11v26" fill="none" stroke="#c59b49" stroke-width="1.1"/>
          </g>
          <g class="ring-clothing ring-jeans-bottom" transform="translate(90 165) scale(3.1) translate(-90 -165)" aria-hidden="true">
            <path d="M79 155h22l-2 13-3 10h-7l-1-8-1 8h-7l-3-10z" fill="#315e7b" stroke="#f1d18a" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M79 158h22m-11 0v9m-8-6-2 9m16-9 2 9" fill="none" stroke="#e7bd65" stroke-width="1.1"/>
          </g>
          <g class="ring-clothing ring-shirt-left" transform="translate(15 97) scale(3.1) translate(-15 -97)" aria-hidden="true">
            <path d="m5 77 10 6 10-6 11 7-5 11-6-3 3 25H3l3-25-6 3-5-11z" fill="#e9e5dc" stroke="#f1d18a" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="m5 77 10 11 10-11m-10 11v26" fill="none" stroke="#c59b49" stroke-width="1.1"/>
          </g>
        </svg>
        <span>DENIM</span><strong>EST.<br>VOGUE</strong><small>JEANS · SHIRTS</small>
      </div>
    </section>
    <section id="collection" class="catalog-section">
    <div class="catalog-heading"><div><p class="eyebrow mb-1">THE COLLECTION</p><h2 class="mb-0 fw-bold text-uppercase"><%= title %></h2></div><span class="catalog-note">Find your fit. Make it yours.</span></div>
    <form class="catalog-filters row g-2 mb-4" method="get" action="<%= category ? '/' + category : '/' %>">
      <div class="col-sm-6"><input class="form-control" type="search" name="q" value="<%= q %>" placeholder="Search products..."></div>
      <div class="col-sm-4"><select class="form-select" name="sort"><option value="newest" <%= sort==='newest'?'selected':'' %>>Newest</option><option value="price-asc" <%= sort==='price-asc'?'selected':'' %>>Price: low to high</option><option value="price-desc" <%= sort==='price-desc'?'selected':'' %>>Price: high to low</option><option value="name" <%= sort==='name'?'selected':'' %>>Name</option></select></div>
      <div class="col-sm-2"><button class="btn btn-primary w-100">Apply</button></div>
    </form>
    <% if (!jeans.length) { %><div class="alert alert-light text-center">No products found. Try another search.</div><% } %>
    <div id="product-grid" class="row g-3"><%- include('product-cards', { jeans }) %></div>
    <div id="scroll-sentinel" class="text-center py-4" data-category="<%= category %>" data-q="<%= q %>" data-sort="<%= sort %>">
      <p id="load-status" class="load-status text-white-50 mb-2" aria-live="polite"></p><button id="load-more" class="btn btn-outline-light" <%= hasMore ? '' : 'hidden' %>>Load more products</button>
    </div>
    </section>
  </main>
  <footer class="store-footer"><div class="container d-flex flex-wrap justify-content-between align-items-center gap-3"><a href="/" class="footer-brand">VOGUE DENIM</a><nav aria-label="Footer"><a href="/about">Our story</a><a href="/contact">Contact</a><a href="/orders">My orders</a></nav><span>Wear the style.</span></div></footer>
  <button type="button" class="back-to-top" id="backToTop" aria-label="Back to top" title="Back to top">↑</button>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/variant-picker.js"></script>
  <script>
    document.querySelectorAll('.auto-dismiss-notice').forEach(notice=>{window.setTimeout(()=>{notice.classList.add('notice-dismissed');window.setTimeout(()=>notice.remove(),350)},7000)});
    function openFullImage(src){document.getElementById('fullImage').src=src;document.getElementById('imagePreviewOverlay').style.display='flex'}
    (()=>{
      const grid=document.getElementById('product-grid'), sentinel=document.getElementById('scroll-sentinel');
      const button=document.getElementById('load-more'), status=document.getElementById('load-status');
      const progress=document.getElementById('scrollProgress'), backToTop=document.getElementById('backToTop');
      const revealObserver='IntersectionObserver' in window?new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');revealObserver.unobserve(entry.target)}}),{threshold:.12,rootMargin:'0px 0px -30px 0px'}):null;
      function revealCards(root=grid){root.querySelectorAll('.product-card:not(.reveal-ready)').forEach((card,index)=>{card.classList.add('reveal-ready');card.style.setProperty('--reveal-delay',`${Math.min(index%4,3)*70}ms`);if(revealObserver)revealObserver.observe(card);else card.classList.add('is-visible')})}
      let scrollFrame=false;
      window.addEventListener('scroll',()=>{if(scrollFrame)return;scrollFrame=true;requestAnimationFrame(()=>{const max=document.documentElement.scrollHeight-window.innerHeight;progress.style.transform=`scaleX(${max>0?window.scrollY/max:0})`;backToTop.classList.toggle('is-visible',window.scrollY>520);document.querySelector('.store-navbar').classList.toggle('has-scrolled',window.scrollY>12);scrollFrame=false})},{passive:true});
      backToTop.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));
      document.querySelectorAll('#storeNavigation .nav-link').forEach(link=>link.addEventListener('click',()=>{const menu=document.getElementById('storeNavigation');if(menu.classList.contains('show'))bootstrap.Collapse.getOrCreateInstance(menu).hide()}));
      revealCards();
      let page=1, loading=false, hasMore=<%= hasMore ? 'true' : 'false' %>;
      async function loadNext(){
        if(loading||!hasMore)return; loading=true; button.disabled=true; status.textContent='Loading more styles…'; if(window.showSiteLoader)window.showSiteLoader('Loading more styles…',450);
        const params=new URLSearchParams({page:String(page+1),category:sentinel.dataset.category,q:sentinel.dataset.q,sort:sentinel.dataset.sort});
        try{const response=await fetch('/api/products?'+params.toString(),{headers:{Accept:'application/json'}});if(!response.ok)throw new Error('Could not load products');const data=await response.json();grid.insertAdjacentHTML('beforeend',data.html);revealCards();if(window.initVariantPickers)window.initVariantPickers(grid);page+=1;hasMore=data.hasMore;status.textContent=hasMore?'Scroll for more styles':'You have seen all products.';button.hidden=!hasMore;}
        catch(error){status.textContent='Products load nahi ho sake. Dobara try karein.';button.hidden=false;}
        finally{loading=false;button.disabled=false;if(window.hideSiteLoader)window.hideSiteLoader();}
      }
      button.addEventListener('click',loadNext);
      if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>{if(entries.some(entry=>entry.isIntersecting))loadNext()},{rootMargin:'300px'});observer.observe(sentinel);}
      status.textContent=hasMore?'Scroll down to discover more styles.':'You have seen all products.';
    })();
  </script>
</body></html>
