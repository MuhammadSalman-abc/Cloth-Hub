<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= product.name %> | Vogue Denim</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/site-loader') %><nav class="navbar navbar-dark bg-dark p-3"><div class="container"><a class="navbar-brand" href="/"><img class="site-logo" src="/images/vogue-denim-logo.svg" alt="Vogue Denim"></a><a href="/cart" class="btn btn-warning">Cart</a></div></nav><main class="container py-5"><div class="row g-4 align-items-center product-detail"><div class="col-md-6"><div class="product-detail-image"><img class="img-fluid" src="<%= product.image %>" alt="<%= product.name %>"></div></div><div class="col-md-6"><p class="text-uppercase text-muted"><%= product.category %> · VOGUE DENIM</p><h1 class="display-5 fw-bold"><%= product.name %></h1><p><%= product.description || 'Comfortable everyday denim.' %></p><p class="h4 text-primary">Rs. <%= salePrice.toFixed(2) %></p><p class="stock-note"><%= product.stock > 0 ? `${product.stock} available` : 'Out of stock' %></p><form action="/add-to-cart" method="post" class="product-buy-form"><input type="hidden" name="productId" value="<%= product._id %>"><label class="form-label fw-semibold">Choose size</label><div class="variant-picker mb-4" data-option-name="size"><input type="hidden" name="size" value="30"><span class="variant-indicator" aria-hidden="true"></span><% ['30','32','34','36'].forEach((size,index)=>{ %><button class="variant-choice <%= index===0?'is-selected':'' %>" type="button" data-value="<%= size %>" aria-pressed="<%= index===0?'true':'false' %>"><%= size %></button><% }) %></div><label class="form-label fw-semibold">Choose color</label><div class="variant-picker color-picker mb-4" data-option-name="color"><input type="hidden" name="color" value="Default"><span class="variant-indicator" aria-hidden="true"></span><% [['Default','Image'],['Blue','Blue'],['Black','Black']].forEach(([value,label],index)=>{ %><button class="variant-choice <%= index===0?'is-selected':'' %>" type="button" data-value="<%= value %>" aria-pressed="<%= index===0?'true':'false' %>"><%= label %></button><% }) %></div><label class="form-label" for="productQuantity">Quantity</label><input id="productQuantity" class="form-control mb-4" type="number" name="quantity" value="1" min="1" max="10"><button class="btn btn-dark btn-lg w-100 add-to-cart-cta" <%= product.stock < 1 ? 'disabled' : '' %>>Add to cart <span aria-hidden="true">→</span></button></form></div></div></main><script src="/variant-picker.js" defer></script></body></html>
