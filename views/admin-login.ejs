<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin login | Vogue Denim</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/site-loader') %><main class="auth-container"><section class="card auth-card p-4 shadow" style="width:100%;max-width:420px"><h1 class="h3 text-center mb-4">Store admin sign in</h1><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><form action="/admin/login" method="post"><div class="mb-3"><label class="form-label" for="email">Admin email</label><input class="form-control" id="email" type="email" name="email" autocomplete="username" required></div><div class="mb-3"><label class="form-label" for="password">Password</label><input class="form-control" id="password" type="password" name="password" autocomplete="current-password" required></div><button class="btn btn-dark w-100">Sign in to admin</button></form><div class="d-flex justify-content-between mt-3"><a href="/forgot-password">Forgot password?</a><a href="/login">Customer login</a></div></section></main></body></html>
