<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Forgot password | Vogue Denim</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/site-loader') %><main class="auth-container"><section class="card auth-card p-4 shadow" style="width:100%;max-width:440px"><h1 class="h3 text-center mb-3">Reset your password</h1><% if (typeof submitted !== 'undefined' && submitted) { %><div class="alert alert-info"><%= typeof message !== 'undefined' ? message : '' %></div><% if (typeof resetLink !== 'undefined' && resetLink) { %><div class="alert alert-warning"><p class="mb-2">Local reset link (valid for 15 minutes):</p><a class="d-block text-break" href="<%= resetLink %>">Open password reset</a></div><% } %><a class="btn btn-outline-dark w-100" href="/login">Back to login</a><% } else { %><p class="text-muted">Enter your account email. Since this app is running locally without email delivery, the reset link will appear here on this computer.</p><form action="/forgot-password" method="post"><label class="form-label" for="email">Email address</label><input class="form-control mb-3" id="email" name="email" type="email" autocomplete="email" required><button class="btn btn-dark w-100">Create reset link</button></form><a class="d-block text-center mt-3" href="/login">Back to login</a><% } %></section></main></body></html>
