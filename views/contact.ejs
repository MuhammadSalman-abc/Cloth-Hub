<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Contact | Vogue Denim</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/style.css?v=20261127"></head><body>
<%- include('partials/site-loader') %>
<nav class="navbar navbar-expand-lg navbar-dark store-navbar sticky-top"><div class="container"><a href="/" class="navbar-brand"><img class="store-logo" src="/images/vogue-denim-logo.svg" alt="Vogue Denim"></a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#siteNav" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="siteNav"><div class="navbar-nav me-auto ms-lg-4"><a class="nav-link" href="/">All</a><a class="nav-link" href="/men">Men</a><a class="nav-link" href="/women">Women</a><a class="nav-link" href="/kids">Kids</a></div><div class="store-account"><a href="/orders" class="btn btn-outline-light btn-sm">My orders</a><a href="/cart" class="btn btn-warning btn-sm">Cart</a></div></div></div></nav>
<main class="container py-5"><section class="store-hero mb-4"><div class="store-hero-copy"><p class="eyebrow">WE'RE HERE TO HELP</p><h1>Let's talk.</h1><p>Questions about sizing, products or an order? Contact our team and we’ll help you out.</p></div></section><div class="row g-4"><div class="col-lg-7"><article class="card card-body h-100 p-4"><p class="eyebrow">CUSTOMER SUPPORT</p><h2 class="h3">How can we help?</h2><p>For order updates, include your order number when you message us. For product questions, send the product name and size you’re interested in.</p><a class="btn btn-gold align-self-start" href="/orders">View my orders</a></article></div><div class="col-lg-5"><article class="card card-body h-100 p-4"><p class="eyebrow">GET IN TOUCH</p><h2 class="h3">WhatsApp support</h2><p>Message the store directly for help with your shopping or order.</p><% if (whatsappNumber) { %><a class="btn btn-success btn-lg" href="https://wa.me/<%= whatsappNumber %>" target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a><% } else { %><p class="text-muted mb-0">WhatsApp contact is not configured yet.</p><% } %></article></div></div></main>
<footer class="store-footer"><div class="container d-flex flex-wrap justify-content-between align-items-center gap-3"><a href="/" class="footer-brand">VOGUE DENIM</a><nav><a href="/about">Our story</a><a href="/contact">Contact</a><a href="/orders">My orders</a></nav><span>Wear the style.</span></div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script></body></html>
