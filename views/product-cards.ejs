<% jeans.forEach(item => { %>
  <div class="col-6 col-md-4 col-lg-3 d-flex align-items-stretch">
    <div class="card product-card p-0 shadow-sm w-100 border-0 overflow-hidden position-relative">
      <div style="height:220px;background:#f8f9fa;display:flex;align-items:center;justify-content:center;overflow:hidden;cursor:zoom-in"><img src="<%= item.image %>" alt="<%= item.name %>" onclick="openFullImage(this.src)" style="max-height:100%;width:auto;object-fit:contain;padding:10px"></div>
      <span class="badge bg-danger position-absolute top-0 end-0 m-2 p-1 small shadow">-20%</span>
      <div class="card-body text-center p-2 d-flex flex-column justify-content-between"><div><h6 class="fw-bold text-uppercase mb-1" style="font-size:.85rem;height:35px;overflow:hidden"><%= item.name %></h6><p class="price-old text-decoration-line-through mb-0 small">Rs. <%= item.price %></p><p class="fw-bold text-primary mb-2">Rs. <%= (item.price*.8).toFixed(2) %></p><p class="small text-muted">Stock: <%= item.stock %></p></div><a href="/products/<%= item._id %>" class="btn btn-outline-dark btn-sm w-100 mb-2">Details</a><button type="button" class="btn btn-dark btn-sm w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#modal<%= item._id %>" <%= item.stock<1?'disabled':'' %>>Add to Cart</button></div>
    </div>
  </div>
  <div class="modal fade style-modal" id="modal<%= item._id %>" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-sm"><div class="modal-content border-0 shadow"><div class="modal-header bg-dark text-white py-2"><h6 class="modal-title fw-bold">Choose your fit</h6><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><form action="/add-to-cart" method="post"><div class="modal-body p-3"><p class="small">Item: <strong><%= item.name %></strong></p><input type="hidden" name="productId" value="<%= item._id %>"><label class="form-label small fw-bold">Size</label><div class="variant-picker mb-3" data-option-name="size"><input type="hidden" name="size" value="30"><span class="variant-indicator" aria-hidden="true"></span><% ['30','32','34','36'].forEach((size,index)=>{ %><button class="variant-choice <%= index===0?'is-selected':'' %>" type="button" data-value="<%= size %>" aria-pressed="<%= index===0?'true':'false' %>"><%= size %></button><% }) %></div><label class="form-label small fw-bold">Color</label><div class="variant-picker color-picker mb-3" data-option-name="color"><input type="hidden" name="color" value="Default"><span class="variant-indicator" aria-hidden="true"></span><% [['Default','Image'],['Blue','Blue'],['Black','Black']].forEach(([value,label],index)=>{ %><button class="variant-choice <%= index===0?'is-selected':'' %>" type="button" data-value="<%= value %>" aria-pressed="<%= index===0?'true':'false' %>"><%= label %></button><% }) %></div><label class="form-label small fw-bold" for="qty<%= item._id %>">Quantity</label><input id="qty<%= item._id %>" type="number" name="quantity" class="form-control form-control-sm" value="1" min="1" max="10"></div><div class="modal-footer p-2"><button type="submit" class="btn btn-warning btn-sm w-100 fw-bold">Add to cart</button></div></form></div></div></div>
<% }) %>
