<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Choose a new password | Vogue Denim</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/site-loader') %><main class="auth-container"><section class="card auth-card p-4 shadow" style="width:100%;max-width:440px"><h1 class="h3 text-center mb-3">Choose a new password</h1><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><% if (token) { %><form action="/reset-password" method="post"><input type="hidden" name="token" value="<%= token %>"><label class="form-label" for="password">New password</label><input class="form-control mb-3" id="password" name="password" type="password" minlength="8" maxlength="128" autocomplete="new-password" required><button class="btn btn-dark w-100">Save new password</button></form><% } %><a class="d-block text-center mt-3" href="/forgot-password">Request another reset link</a></section></main></body></html>
