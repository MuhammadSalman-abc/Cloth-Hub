<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin | Vogue Denim</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/style.css"><style>.admin-order{border-left:5px solid #ffc107}.admin-order[data-status="delivered"]{border-left-color:#198754}.admin-order[data-status="cancelled"],.admin-order[data-status="failed"]{border-left-color:#dc3545}.summary-card{min-height:110px}</style></head>
<body>
<%- include('partials/site-loader') %><nav class="navbar navbar-dark bg-dark p-3"><div class="container"><a class="navbar-brand" href="/"><img class="site-logo" src="/images/vogue-denim-logo.svg" alt="Vogue Denim"> <span class="ms-2 small">ADMIN</span></a><div class="d-flex gap-2"><a href="/" class="btn btn-outline-light">Shop</a><a href="/orders" class="btn btn-outline-light">Customer view</a></div></div></nav>
<main class="container py-4"><div class="d-flex justify-content-between align-items-center flex-wrap gap-2"><div><h1>Store dashboard</h1><p class="text-muted mb-0">Check customer orders, delivery details and update fulfilment status.</p></div><span class="badge bg-dark"><%= user.email %></span></div>
<% if (notice) { %><div class="alert alert-info mt-3"><%= notice %></div><% } %>
<div class="row g-3 my-2"><div class="col-md-4"><div class="card card-body summary-card"><small class="text-muted">All orders</small><strong class="display-6"><%= totalOrders %></strong></div></div><div class="col-md-4"><div class="card card-body summary-card"><small class="text-muted">Need fulfilment</small><strong class="display-6"><%= openOrders %></strong></div></div><div class="col-md-4"><div class="card card-body summary-card"><small class="text-muted">Products in catalog</small><strong class="display-6"><%= totalProducts %></strong></div></div></div>
<h2 class="h4 mt-4 mb-3">Recent customer orders</h2>
<% if (!orders.length) { %><div class="card card-body">Abhi koi order nahi aaya. Customer ka order yahan dikh jayega.</div><% } %>
<div class="d-grid gap-3"><% orders.forEach(order => { const customer = order.userId || {}; const ship = order.shipping || {}; const rawPhone = String(ship.phone || '').replace(/\D/g,''); const waPhone = rawPhone.startsWith('0') ? '92'+rawPhone.slice(1) : rawPhone; %>
<article class="card card-body admin-order" data-status="<%= order.status %>"><div class="d-flex justify-content-between align-items-start flex-wrap gap-2"><div><h3 class="h5 mb-1">Order <%= order._id %></h3><small class="text-muted"><%= order.createdAt ? new Date(order.createdAt).toLocaleString() : '' %></small></div><div class="text-end"><span class="badge <%= ['delivered','paid'].includes(order.status)?'bg-success':['cancelled','failed'].includes(order.status)?'bg-danger':'bg-warning text-dark' %>"><%= order.status %></span><div class="fw-bold mt-1">Rs. <%= Number(order.total || 0).toFixed(2) %></div></div></div>
<div class="row g-3 mt-1"><section class="col-lg-4"><h4 class="h6">Customer</h4><div><strong><%= customer.name || 'Account unavailable' %></strong></div><div><%= customer.email || '—' %></div><div><%= ship.phone || 'Phone not provided' %></div><% if (waPhone) { %><a class="btn btn-sm btn-outline-success mt-2" target="_blank" rel="noopener" href="https://wa.me/<%= waPhone %>">WhatsApp customer</a><% } %></section>
<section class="col-lg-4"><h4 class="h6">Deliver to</h4><div><%= ship.address || 'Address not provided' %></div><div><strong><%= ship.city || '' %></strong></div><% if (ship.notes) { %><div class="small text-muted mt-1">Note: <%= ship.notes %></div><% } %></section>
<section class="col-lg-4"><h4 class="h6">Items · <%= order.paymentMethod === 'cash_on_delivery' ? 'Cash on delivery' : order.paymentMethod %></h4><ul class="mb-0 ps-3"><% order.items.forEach(item => { %><li><%= item.name %> · size <%= item.size %>, <%= item.color %> × <%= item.quantity %></li><% }) %></ul></section></div>
<form class="d-flex align-items-center gap-2 mt-3 pt-3 border-top" action="/admin/orders/<%= order._id %>/status" method="post"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><label class="form-label mb-0" for="status-<%= order._id %>">Update status</label><select class="form-select form-select-sm" style="max-width:200px" id="status-<%= order._id %>" name="status"><% for (const status of ['pending','confirmed','shipped','delivered','cancelled','paid','failed']) { %><option value="<%= status %>" <%= order.status===status?'selected':'' %>><%= status.replace('_',' ') %></option><% } %></select><button class="btn btn-sm btn-primary">Save</button></form></article>
<% }) %></div></main></body></html>
