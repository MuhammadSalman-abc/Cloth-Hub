<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Your Cart | Vogue Denim</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/style.css"></head>
<body>
<%- include('partials/site-loader') %><nav class="navbar navbar-dark bg-dark p-3"><div class="container"><a class="navbar-brand" href="/"><img class="site-logo" src="/images/vogue-denim-logo.svg" alt="Vogue Denim"></a><a class="btn btn-outline-light" href="/orders">My orders</a></div></nav>
<main class="container py-5"><h1 class="mb-4">Shopping cart</h1><% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-info"><%= notice %></div><% } %>
<% const cartTotal = typeof total !== 'undefined' ? total : (cart ? cart.items.reduce((sum, item) => sum + item.price * (item.quantity || 1), 0) : 0); %>
<% if (cart && cart.items.length) { %><div class="card shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-dark"><tr><th>Product</th><th>Options</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th></th></tr></thead><tbody>
<% cart.items.forEach(item => { %><tr><td><div class="d-flex align-items-center gap-3"><img src="<%= item.image || '/images/background.jpg' %>" onerror="this.onerror=null;this.src='/images/background.jpg'" alt="<%= item.name %>" width="64" height="64" style="object-fit:cover;background:#f8f9fa;border-radius:6px"><strong><%= item.name %></strong></div></td><td>Size <%= item.size %><br><span class="text-muted"><%= item.color %></span></td><td>Rs. <%= item.price.toFixed(2) %></td><td><form class="d-flex gap-2" action="/cart/update/<%= item._id %>" method="post"><input class="form-control form-control-sm" type="number" name="quantity" value="<%= item.quantity %>" min="1" max="10" style="width:75px"><button class="btn btn-outline-primary btn-sm">Update</button></form></td><td>Rs. <%= (item.price * item.quantity).toFixed(2) %></td><td><form action="/cart/remove/<%= item._id %>" method="post"><button class="btn btn-outline-danger btn-sm">Remove</button></form></td></tr><% }) %>
</tbody></table></div></div><div class="row justify-content-end mt-4"><div class="col-md-5 col-lg-4"><div class="card card-body"><div class="d-flex justify-content-between"><span>Subtotal</span><strong>Rs. <%= cartTotal.toFixed(2) %></strong></div><small class="text-muted mt-2">Shipping and any applicable charges are shown at checkout.</small><a href="/checkout" class="btn btn-success btn-lg mt-3">Continue to checkout</a><a href="/" class="btn btn-outline-dark mt-2">Continue shopping</a></div></div></div>
<% } else { %><div class="card card-body text-center py-5"><p>Your cart is empty.</p><a href="/" class="btn btn-primary mx-auto">Go shopping</a></div><% } %></main></body></html>
