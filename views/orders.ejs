<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Orders | Vogue Denim</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/style.css"></head><body>
<%- include('partials/site-loader') %><nav class="navbar navbar-dark bg-dark p-3"><div class="container"><a class="navbar-brand" href="/"><img class="site-logo" src="/images/vogue-denim-logo.svg" alt="Vogue Denim"></a><a href="/cart" class="btn btn-warning">Cart</a></div></nav><main class="container py-5"><h1>My orders</h1><% if (!orders.length) { %><div class="card card-body mt-3">No orders yet. <a href="/">Browse products</a></div><% } else { %><div class="list-group mt-3"><% orders.forEach(order => { %><a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/orders/<%= order._id %>"><span><strong>Order <%= order._id %></strong><br><small><%= order.createdAt.toLocaleString() %></small></span><span class="text-end"><span class="badge <%= order.status === 'paid' ? 'bg-success' : order.status === 'failed' ? 'bg-danger' : 'bg-warning text-dark' %>"><%= order.status %></span><br>Rs. <%= order.total.toFixed(2) %></span></a><% }) %></div><% } %></main></body></html>
