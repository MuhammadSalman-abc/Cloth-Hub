<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Checkout | Vogue Denim</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/style.css"></head>
<body>
<%- include('partials/site-loader') %>
<nav class="navbar navbar-dark bg-dark p-3"><div class="container"><a class="navbar-brand" href="/"><img class="site-logo" src="/images/vogue-denim-logo.svg" alt="Vogue Denim"></a><a href="/cart" class="btn btn-outline-light">Back to cart</a></div></nav>
<main class="container py-5">
  <h1>Checkout</h1>
  <% if (typeof notice !== 'undefined' && notice) { %><div class="alert alert-warning"><%= notice %></div><% } %>
  <div class="row g-4 mt-1">
    <section class="col-lg-7">
      <form class="card card-body" action="/place-order" method="post">
        <h2 class="h5">Delivery details</h2>
        <p class="text-muted">Payment method: <strong>Cash on delivery</strong>. Order milne par cash dein.</p>
        <p class="mb-3">Order for <strong><%= user.name %></strong> (<%= user.email %>)</p>
        <label class="form-label" for="phone">Phone number</label><input class="form-control mb-3" id="phone" name="phone" type="tel" autocomplete="tel" required minlength="10" maxlength="20" placeholder="03XX XXXXXXX">
        <label class="form-label" for="address">Delivery address</label><textarea class="form-control mb-3" id="address" name="address" rows="3" required minlength="8" maxlength="300" placeholder="House, street, area"></textarea>
        <label class="form-label" for="city">City</label><input class="form-control mb-3" id="city" name="city" required minlength="2" maxlength="80">
        <label class="form-label" for="notes">Order notes (optional)</label><textarea class="form-control mb-3" id="notes" name="notes" rows="2" maxlength="500"></textarea>
        <button class="btn btn-success btn-lg">Place order · Cash on delivery</button>
      </form>
    </section>
    <aside class="col-lg-5"><div class="card card-body">
      <h2 class="h5">Order summary</h2>
      <% cart.items.forEach(item => { %><div class="d-flex justify-content-between py-2 border-bottom"><span><%= item.name %> · size <%= item.size %> × <%= item.quantity %></span><strong>Rs. <%= (item.price * item.quantity).toFixed(2) %></strong></div><% }) %>
      <div class="d-flex justify-content-between mt-3"><span>Total</span><strong>Rs. <%= total.toFixed(2) %></strong></div>
      <small class="text-muted mt-2">Product prices and available stock are checked again when you place the order.</small>
      <% if (storeWhatsApp) { %><a class="btn btn-outline-success mt-3" target="_blank" rel="noopener" href="https://wa.me/<%= storeWhatsApp %>">Contact us on WhatsApp</a><% } %>
    </div></aside>
  </div>
</main></body></html>
