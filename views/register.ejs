<!-- views/register.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jeans Store | Register</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/svg+xml" href="/images/vogue-denim-favicon.svg?v=2">
    <link rel="stylesheet" href="/style.css?v=20261127a">
</head>
<body>
<%- include('partials/site-loader') %>
    <div class="auth-container">
        <div class="card auth-card p-4 shadow auth-register-card" style="width: 100%; max-width: 440px;">
            <a class="auth-brand" href="/" aria-label="Vogue Denim home"><img src="/images/vogue-denim-logo.svg" alt="Vogue Denim"></a>
            <h3 class="text-center mb-4">Create Account</h3>
            <% if (typeof error !== 'undefined') { %><div class="alert alert-danger"><%= error %></div><% } %>
            <form action="/register" method="POST">
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" name="name" class="form-control bg-light" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" name="email" class="form-control bg-light" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control bg-light" minlength="8" maxlength="128" required>
                </div>
                <button type="submit" class="btn btn-custom w-100">Register</button>
            </form>
            <div class="text-center mt-3">
                <p>Already have an account? <a href="/login">Login Here</a></p>
            </div>
        </div>
    </div>
</body>
</html>
